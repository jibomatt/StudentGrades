@model IEnumerable<StudentGrades.Models.StudentGradeView>
@{
    ViewData["Title"] = "Grade Report";
    var search = ViewBag.Search as string;
    var remarks = ViewBag.Remarks as string ?? "ALL";
}

<h2>Student Grade Report</h2>

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-md-5">
        <label for="search" class="form-label">Search student name</label>
        <input type="text" id="search" name="search" value="@search" class="form-control" placeholder="e.g. Juan" />
    </div>
    <div class="col-md-3">
        <label for="remarks" class="form-label">Show</label>
        <select id="remarks" name="remarks" class="form-select" onchange="this.form.submit()">
            <option value="ALL" selected="@(remarks == "ALL")">All students</option>
            <option value="PASS" selected="@(remarks == "PASS")">PASS only</option>
            <option value="FAIL" selected="@(remarks == "FAIL")">FAIL only</option>
        </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<p class="text-muted">@Model.Count() record(s) found.</p>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Student Name</th>
            <th>Subject Name</th>
            <th class="text-end">Grade</th>
            <th class="text-center">Remarks</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="4" class="text-center text-muted">No records match your search.</td></tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.StudentName</td>
                <td>@item.SubjectName</td>
                <td class="text-end">@item.Grade.ToString("0.##")</td>
                <td class="text-center"><partial name="_RemarksBadge" model="item.Remarks" /></td>
            </tr>
        }
    </tbody>
</table>
