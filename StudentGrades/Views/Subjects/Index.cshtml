@model IEnumerable<StudentGrades.Models.Subject>
@{ ViewData["Title"] = "Subjects"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Subjects (mst_subject)</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add Subject</a>
</div>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Subject Key</th>
            <th>Subject Name</th>
            <th style="width:160px">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="3" class="text-center text-muted">No subjects yet. Add one to get started.</td></tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SubjectKey</td>
                <td>@item.SubjectName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.SubjectKey" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.SubjectKey" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
