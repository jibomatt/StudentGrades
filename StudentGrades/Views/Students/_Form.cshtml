@model StudentGrades.Models.Student
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@if (ViewBag.HasSubjects == false)
{
    <div class="alert alert-warning">
        There are no subjects yet. <a asp-controller="Subjects" asp-action="Create">Add a subject</a> first.
    </div>
}

<div class="mb-3">
    <label asp-for="StudentName" class="form-label"></label>
    <input asp-for="StudentName" class="form-control" autofocus />
    <span asp-validation-for="StudentName" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="SubjectKey" class="form-label"></label>
    <select asp-for="SubjectKey" asp-items="ViewBag.Subjects" class="form-select">
        <option value="">-- Select subject --</option>
    </select>
    <span asp-validation-for="SubjectKey" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Grade" class="form-label"></label>
    <input asp-for="Grade" type="number" step="0.01" min="0" max="100" class="form-control" id="gradeInput" />
    <span asp-validation-for="Grade" class="text-danger"></span>
</div>
<div class="mb-3">
    <label class="form-label">Remarks <small class="text-muted">(automatic: 75 or higher is PASS)</small></label>
    @* No name attribute, so this value is never posted. The database calculates the real value. *@
    <input type="text" id="remarksPreview" class="form-control" value="@Model.Remarks" readonly tabindex="-1" />
</div>
