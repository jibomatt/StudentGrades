@model StudentGrades.Models.Student
@{ ViewData["Title"] = "Edit Student Grade"; }

<h2>Edit Student Grade</h2>
<div class="row"><div class="col-md-6">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="StudentKey" />
        <div class="mb-3">
            <label asp-for="StudentKey" class="form-label"></label>
            <input asp-for="StudentKey" class="form-control" disabled />
        </div>
        <partial name="_Form" model="Model" />
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_RemarksScript" />
}
