@model StudentGrades.Models.Subject
@{ ViewData["Title"] = "Edit Subject"; }

<h2>Edit Subject</h2>
<div class="row"><div class="col-md-6">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="SubjectKey" />
        <div class="mb-3">
            <label asp-for="SubjectKey" class="form-label"></label>
            <input asp-for="SubjectKey" class="form-control" disabled />
        </div>
        <partial name="_Form" model="Model" />
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
